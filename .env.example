LITELLM_MASTER_KEY=your_master_key_here
HA_URL=http://localhost:8123
HA_TOKEN=your_home_assistant_token_here

# Optional SDLC MCP deployment overlay. Pin released versions or image digests in shared environments.
FORGEJO_MCP_IMAGE=ghcr.io/vrsarin/forgejo-mcp-server:main
WIKIJS_SDLC_MCP_IMAGE=ghcr.io/vrsarin/wikijs-sdlc-mcp-server:main
FORGEJO_MCP_PORT=3010
WIKIJS_SDLC_MCP_PORT=3011
ENABLE_OIDC=false
ENABLE_TLS=false
# Required when ENABLE_TLS=true: letsencrypt or static.
TLS_MODE=
TLS_EMAIL=
FORGEJO_MCP_TLS_DOMAIN=
FORGEJO_MCP_TLS_CERT_PATH=
FORGEJO_MCP_TLS_KEY_PATH=
WIKIJS_SDLC_MCP_TLS_DOMAIN=
WIKIJS_SDLC_MCP_TLS_CERT_PATH=
WIKIJS_SDLC_MCP_TLS_KEY_PATH=

# Compatibility bearer tokens for direct static authentication. They are ignored when ENABLE_OIDC is explicitly false.
FORGEJO_MCP_CLIENT_TOKENS=
WIKIJS_SDLC_MCP_CLIENT_TOKENS=

# Set these to the matching token values from the JSON maps above. Codex reads them at runtime.
FORGEJO_MCP_BEARER_TOKEN=
WIKIJS_SDLC_MCP_BEARER_TOKEN=

# Provider credentials for the bot identity. Keep them read-only until the integration is verified.
FORGEJO_ACCESS_TOKEN=
WIKIJS_ACCESS_TOKEN=

# Provider addresses as seen from the MCP containers. Use HTTPS outside an isolated local environment.
FORGEJO_URL=https://forgejo.example.com
WIKIJS_MCP_URL=https://wiki.example.com/_mcp
FORGEJO_ALLOW_INSECURE_HTTP=false
WIKIJS_ALLOW_INSECURE_MCP_HTTP=false
SDLC_ALLOWED_REPOSITORIES=example-owner/example-repository
SDLC_ENABLE_WRITES=false

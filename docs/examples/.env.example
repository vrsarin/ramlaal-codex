# Initial discovery tags only. Replace with tested image digests before sharing.
PGVECTOR_IMAGE=pgvector/pgvector:pg17
OLLAMA_IMAGE=ollama/ollama:latest
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable

# Illustrative local models, not a tested Codex compatibility pairing.
OLLAMA_CHAT_MODEL=gpt-oss:20b
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_CHAT_ROUTE=ollama_chat/gpt-oss:20b
OLLAMA_EMBED_ROUTE=openai/embeddinggemma
OLLAMA_CONTEXT_LENGTH=65536
EMBEDDING_SPACE_ID=embeddinggemma-poc-v1

# Replace locally. Never commit populated .env or authentication files.
POSTGRES_PASSWORD=replace-with-random-password
RAMONA_DB_PASSWORD=replace-with-separate-runtime-password
LITELLM_MASTER_KEY=sk-replace-with-random-key

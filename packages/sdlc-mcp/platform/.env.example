# Local development only. The setup wizard creates .env from this file.
# Passwords and service secrets are supplied by the wizard, not stored here.
COMPOSE_PROJECT_NAME=forgejo-wikijs-sdlc

# Local endpoints
BIND_ADDRESS=127.0.0.1
FORGEJO_HOSTNAME=git.localhost
WIKIJS_HOSTNAME=wiki.localhost
KEYCLOAK_HOSTNAME=login.localhost
HOMEASSISTANT_HOSTNAME=home.localhost
FORGEJO_MCP_HOSTNAME=forgejo-mcp.localhost
WIKIJS_SDLC_MCP_HOSTNAME=sdlc-mcp.localhost
FORGEJO_SSH_BIND_ADDRESS=127.0.0.1
FORGEJO_SSH_HOSTNAME=localhost
FORGEJO_SSH_PORT=2222

# Container images
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:17.0.1
WIKIJS_IMAGE=ghcr.io/requarks/wiki:3
POSTGRES_IMAGE=postgres:18
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.1
CADDY_IMAGE=caddy:2-alpine
# The wizard builds these from local source. Other deployments can pull a released tag or digest.
FORGEJO_MCP_IMAGE=ghcr.io/vrsarin/forgejo-mcp-server:main
WIKIJS_SDLC_MCP_IMAGE=ghcr.io/vrsarin/wikijs-sdlc-mcp-server:main
HOMEASSISTANT_MCP_IMAGE=ghcr.io/vrsarin/homeassistant-mcp-server:main

# Forgejo database
FORGEJO_UID=1000
FORGEJO_GID=1000
FORGEJO_DISABLE_REGISTRATION=false
# "admin" is reserved by Forgejo; choose another administrator username.
FORGEJO_ADMIN_USERNAME=forgejo-admin
FORGEJO_ADMIN_EMAIL=admin@example.test
FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo

# Wiki.js database and administrator
WIKIJS_ADMIN_EMAIL=admin@example.test
# HTTPS is trusted through the project CA.
WIKIJS_ALLOW_INSECURE_OIDC=false
# Allows WebAuthn only on the reserved *.localhost development namespace.
WIKIJS_ALLOW_LOCALHOST_PASSKEYS=true
WIKIJS_DB_NAME=wiki
WIKIJS_DB_USER=wiki

# Keycloak database and bootstrap administrator
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_ADMIN_USERNAME=keycloak-admin

# Development realm and test identity
KEYCLOAK_REALM=sdlc
KEYCLOAK_SSO_ADMIN_USERNAME=sdlc-admin
KEYCLOAK_SSO_ADMIN_EMAIL=admin@example.test
KEYCLOAK_SSO_ADMIN_FIRST_NAME=SDLC
KEYCLOAK_SSO_ADMIN_LAST_NAME=Administrator
KEYCLOAK_TEST_USERNAME=developer
KEYCLOAK_TEST_EMAIL=developer@example.test
KEYCLOAK_TEST_FIRST_NAME=Development
KEYCLOAK_TEST_LAST_NAME=User

# OIDC clients
FORGEJO_OIDC_CLIENT_ID=forgejo
WIKIJS_OIDC_CLIENT_ID=wikijs
# Confidential client used by local service integrations.
MCP_OIDC_CLIENT_ID=forgejo-wikijs-mcp
FORGEJO_MCP_OAUTH_CLIENT_ID=forgejo-mcp-vscode
WIKIJS_SDLC_MCP_OAUTH_CLIENT_ID=wikijs-sdlc-mcp-vscode
FORGEJO_MCP_PUBLIC_URL=https://forgejo-mcp.localhost/mcp
WIKIJS_SDLC_MCP_PUBLIC_URL=https://sdlc-mcp.localhost/mcp
# Native security flags. Disable both only for an isolated development network.
ENABLE_OIDC=true
ENABLE_TLS=true
# Public native-TLS deployments choose `letsencrypt` or `static`. The local wizard uses
# static paths populated by its private Step CA through compose.mcp-tls.yaml.
TLS_MODE=static
# TLS_DOMAIN=mcp.example.com
# TLS_EMAIL=ops@example.com
# TLS_CERT_PATH=/run/tls/tls.crt
# TLS_KEY_PATH=/run/tls/tls.key
# Gateway/public HTTPS remains a separate switch because the local gateway stack has its own listener.
SDLC_HTTPS=true
# The setup wizard generates the gateway's local-only runtime secrets.
GATEWAY_HOSTNAME=mcp-gateway.localhost

# Forgejo workflow MCP. First sign-in includes a Forgejo approval; the grant is encrypted at rest.
# This public Keycloak PKCE client identifies the browser before Forgejo consent.
FORGEJO_MCP_LOGIN_CLIENT_ID=forgejo-mcp-login
# The setup wizard registers the Forgejo OAuth application and generates its runtime key.
FORGEJO_OAUTH_CLIENT_ID=
# Must be https, or http on localhost/127.0.0.1. Defaults to the local proxy route.
# FORGEJO_OAUTH_REDIRECT_URL=http://localhost/oauth/forgejo/callback
FORGEJO_MCP_ALLOWED_ORIGINS=
# Comma-separated owner/repository list the Forgejo MCP may touch.
SDLC_ALLOWED_REPOSITORIES=example-owner/example-repository
# Keep write tools off until read-only testing passes.
SDLC_ENABLE_WRITES=false

# Static bearer-token compatibility fallback. The compose stack authenticates through Keycloak
# (`ENABLE_OIDC=true`) and does not read these. Generate each with
# `openssl rand -hex 32` and use a different value per server.
# FORGEJO_MCP_CLIENT_TOKENS={"vscode":"replace-with-openssl-rand-hex-32"}
# WIKIJS_SDLC_MCP_CLIENT_TOKENS={"vscode":"replace-with-a-different-openssl-rand-hex-32"}

# Wiki.js SDLC MCP. First sign-in includes Wiki.js consent; the grant is encrypted at rest.
WIKIJS_MCP_LOGIN_CLIENT_ID=wikijs-mcp-login
# The setup wizard generates the Wiki.js token-encryption key at runtime.
# Must be https, or http on localhost/127.0.0.1. Defaults to the local proxy route.
# WIKIJS_OAUTH_REDIRECT_URL=http://localhost/oauth/wikijs/callback
WIKIJS_SDLC_MCP_ALLOWED_ORIGINS=

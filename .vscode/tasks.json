{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: full stack",
      "type": "shell",
      "command": "docker compose up -d --build --wait",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Docker: memory stack",
      "type": "shell",
      "command": "docker compose up -d --build --wait otel pgvector keycloak memory",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Docker: memory + LiteLLM stack",
      "type": "shell",
      "command": "docker compose up -d --build --wait otel pgvector keycloak memory litellm",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Docker: down",
      "type": "shell",
      "command": "docker compose down",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Docker: pull memory models",
      "type": "shell",
      "command": "ollama pull embeddinggemma; ollama pull llama3.2:3b",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Test: gateway",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/src/gateway" },
      "group": "test"
    },
    {
      "label": "Test: orchestrator",
      "type": "shell",
      "command": "go test ./...",
      "options": { "cwd": "${workspaceFolder}/src/orchestrator" },
      "group": "test"
    },
    {
      "label": "Test: memory",
      "type": "shell",
      "command": "go test ./...",
      "options": { "cwd": "${workspaceFolder}/src/memory" },
      "group": "test"
    },
    {
      "label": "Build: ui",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/src/ui" },
      "group": "test"
    },
    {
      "label": "Test: all",
      "dependsOn": ["Test: gateway", "Test: orchestrator", "Test: memory", "Build: ui"],
      "dependsOrder": "sequence",
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
